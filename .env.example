# Copy to .env and fill in. Never commit .env or put real values in this file.

# Anthropic API key. Used by the daily-journal job (stored as a GitHub secret) and local tests of it.
ANTHROPIC_API_KEY=

# Model used by scripts/write_journal.py
JOURNAL_MODEL=claude-haiku-4-5-20251001

# PostgreSQL (with pgvector): findings, benchmarks and embeddings
POSTGRES_URL=jdbc:postgresql://localhost:5432/quantumshift
POSTGRES_USER=quantumshift
POSTGRES_PASSWORD=

# Local LLM server (Ollama) for the RAG planner
OLLAMA_BASE_URL=http://localhost:11434

# gRPC addresses the Java orchestrator calls
SCANNER_GRPC_ADDR=localhost:50051
CLASSIFIER_GRPC_ADDR=localhost:50052
